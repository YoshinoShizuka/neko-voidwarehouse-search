{
  "schemaVersion": 1,
  "id": "neko_voidwarehouse_search",
  "version": "${version}",
  "name": "Neko VoidWarehouse Search",
  "description": "虚空仓库搜索框：在服务端虚空仓库界面上叠加一个搜索框，支持中文 / 拼音 / 注册名搜索筛选物品。纯客户端模组，服务端需搭配 carpet-Neko-Addition 1.0.16+。",
  "authors": [
    "Akirono"
  ],
  "license": "MIT",
  "icon": "assets/neko_voidwarehouse_search/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "neko.voidwarehouse.search.VoidWarehouseSearchClient"
    ]
  },
  "mixins": [
    "neko_voidwarehouse_search.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.1.1",
    "fabric-api": "*"
  },
  "suggests": {
    "carpet_neko_addition": "*"
  }
}
